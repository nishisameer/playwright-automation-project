{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "jsx": "react-jsx",

    // Short import paths: '@pages/LoginPage' instead of '../../pages/LoginPage'.
    // Playwright reads these automatically.
    "baseUrl": ".",
    "paths": {
      "@api/*": ["api/*"],
      "@config/*": ["config/*"],
      "@fixtures/*": ["fixtures/*"],
      "@pages/*": ["pages/*"],
      "@test-data/*": ["test-data/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
