# Copy this file to .env and change the values you need.
# .env is in .gitignore, so your real values are never committed.
# In CI, set the same names as GitHub Secrets instead.

# Apps under test
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

# Credentials (these defaults are the public demo values)
SAUCE_PASSWORD=secret_sauce
API_USERNAME=admin
API_PASSWORD=password123
